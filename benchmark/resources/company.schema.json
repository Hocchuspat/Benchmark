{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["company_id", "research_status", "official_site", "identity", "facts", "sources", "missing_information", "warnings", "report_issues"],
  "properties": {
    "company_id": {"type": "string"},
    "research_status": {"type": "string", "enum": ["completed", "needs_review", "site_unavailable", "not_found", "ambiguous"]},
    "official_site": {"type": ["string", "null"]},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason", "source_ids"],
      "properties": {
        "status": {"type": "string", "enum": ["confirmed_by_inn", "confirmed_by_details", "unconfirmed", "conflict"]},
        "reason": {"type": "string"},
        "source_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "facts": {
      "type": "object", "additionalProperties": false,
      "required": ["legal_name", "inn", "ogrn", "kpp", "legal_address", "actual_address", "phone", "email", "okved", "primary_activity", "additional_activities", "products_services", "product_service_type", "functional_profile", "functions_summary"],
      "properties": {
        "legal_name": {"$ref": "#/$defs/fact"},
        "inn": {"$ref": "#/$defs/fact"},
        "ogrn": {"$ref": "#/$defs/fact"},
        "kpp": {"$ref": "#/$defs/fact"},
        "legal_address": {"$ref": "#/$defs/fact"},
        "actual_address": {"$ref": "#/$defs/fact"},
        "phone": {"$ref": "#/$defs/fact"},
        "email": {"$ref": "#/$defs/fact"},
        "okved": {"$ref": "#/$defs/fact"},
        "primary_activity": {"$ref": "#/$defs/fact"},
        "additional_activities": {"$ref": "#/$defs/fact"},
        "products_services": {"$ref": "#/$defs/fact"},
        "product_service_type": {"$ref": "#/$defs/fact"},
        "functional_profile": {"$ref": "#/$defs/fact"},
        "functions_summary": {"$ref": "#/$defs/fact"}
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "url", "title", "accessed_at", "kind", "excerpt"],
        "properties": {
          "source_id": {"type": "string"},
          "url": {"type": "string"},
          "title": {"type": "string"},
          "accessed_at": {"type": "string"},
          "kind": {"type": "string", "enum": ["official", "registry", "secondary"]},
          "excerpt": {"type": "string"}
        }
      }
    },
    "missing_information": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "report_issues": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "source_ids", "note"],
      "properties": {
        "value": {"type": ["string", "null"]},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    }
  }
}
